{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfb-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "upload_source_maps": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "cfb", "database_id": "<uuid>" }
  ],

  "r2_buckets": [
    { "binding": "LOGS", "bucket_name": "cfb-logs" }
  ],

  "durable_objects": {
    "bindings": [{ "name": "NODE", "class_name": "NodeDO" }]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NodeDO"] }
  ],

  "vpc_networks": [
    {
      "binding": "SITE",
      "tunnel_id": "<tunnel-uuid>",
      "remote": true
    }
  ],

  "vars": {
    "RUNTIME": "cf"
  },

  "observability": { "enabled": true }
}
